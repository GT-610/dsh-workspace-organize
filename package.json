{
  "name": "dsh-workspace-organize",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Group DSH workspaces into named groups and browse group > workspace > session in the sidebar.",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
